module(
    name = "aws_build_farm",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.61.1")
bazel_dep(name = "gazelle", version = "0.51.3")
bazel_dep(name = "platforms", version = "1.1.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.25.8")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# remote-apis ships BUILD files that depend on @rules_proto, but it also ships
# pre-generated .pb.go. Regenerate it as plain Go (proto rules disabled) so we
# compile the committed .pb.go without pulling in the proto toolchain.
go_deps.gazelle_override(
    build_file_generation = "clean",
    directives = [
        "gazelle:proto disable_global",
    ],
    path = "github.com/bazelbuild/remote-apis",
)

# Populated by `bazel mod tidy`.
use_repo(go_deps, "com_github_aws_aws_sdk_go_v2", "com_github_aws_aws_sdk_go_v2_config", "com_github_aws_aws_sdk_go_v2_feature_s3_manager", "com_github_aws_aws_sdk_go_v2_service_iam", "com_github_aws_aws_sdk_go_v2_service_lambdamicrovms", "com_github_aws_aws_sdk_go_v2_service_s3", "com_github_aws_aws_sdk_go_v2_service_sts", "com_github_aws_smithy_go", "com_github_bazelbuild_remote_apis", "com_github_google_uuid", "com_google_cloud_go_longrunning", "org_golang_google_genproto_googleapis_bytestream", "org_golang_google_genproto_googleapis_rpc", "org_golang_google_grpc", "org_golang_google_protobuf")
